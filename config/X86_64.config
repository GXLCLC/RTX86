# ==================== 目标平台（仅 X86_64 Generic）====================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ==================== 镜像格式与分区 ====================
# 固定 squashfs 格式镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# 根分区总大小：lean 默认约 104MB + 强制扩容 2G(2048MB) = 2152
CONFIG_TARGET_ROOTFS_PARTSIZE=2152
# EFI 引导镜像（工作流发布时保留 EFI 版 img.gz）
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# ==================== 默认主题：Argon ====================
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-argon-config=y
CONFIG_PACKAGE_default-settings-argon=y
# LuCI 基础中文
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ==================== 预装插件（全套完整依赖）====================
# 1. SmartDNS 分流解析
CONFIG_PACKAGE_luci-app-smartdns=y
# 2. DDNSTO 远程控制（默认中文）
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
# 3. AdGuard Home（含核心程序 + 完整依赖）
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_adguardhome=y
# 4. OAF 应用过滤（kmod-oaf 由源码随官方内核本地编译，严格匹配）
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
# 5. TurboACC 加速（仅流量分载 / 全锥形NAT / BBR，SFE 已由冲突脚本移除）
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
# 6. MWAN3 多拨负载均衡
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE-mwan3=y
# 9. 带宽监控
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_nlbwmon=y
# 10. EasyTier 异地组网
CONFIG_PACKAGE_luci-app-easytier=y
# 11. WOL 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
# 12. UPnP
CONFIG_PACKAGE_luci-app-upnp=y
# 13. TTYD 终端
CONFIG_PACKAGE_luci-app-ttyd=y
# 14. 定时重启
CONFIG_PACKAGE_luci-app-autoreboot=y
# 15. 微信推送
CONFIG_PACKAGE_luci-app-wechatpush=y
# 16. 流量监控 
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_bandix=y  
# ============ 中文语言包（带独立 i18n 的插件自动配套 zh-cn）============
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddnsto-zh-cn=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y

# ==================== 常用网卡驱动（严格匹配本机编译内核）====================
# 板载网卡：Intel i211 / i210 系列
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
# 板载网卡：Realtek RTL8111 系列
CONFIG_PACKAGE_kmod-r8169=y
# USB 网卡驱动
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
# USB 存储驱动
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
