#
# ============================================================
# RTX86 - lean LEDE x86_64 Generic 编译配置
# ------------------------------------------------------------
# 目标平台 : x86_64 Generic（仅此一个机型）
# 镜像格式 : squashfs sysupgrade（仅此一种）
# overlay  : rootfs 分区 2048 MiB（2 GiB 可写分区）
# 使用方式: 工作流自动 cp 到源码 .config 后执行 make defconfig
# 增删软件包: 直接修改本文件对应行即可，无需改 yml
# ============================================================
#

# ==================== 目标平台（仅 x86_64 Generic） ====================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_Generic=y

# ==================== 根文件系统与分区 ====================
# 仅生成 squashfs 格式镜像
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# rootfs 分区容量 2048 MiB（x86 默认仅 448 MiB，此处强制扩容到 2 GiB，
# squashfs 只读层之外的剩余空间即 overlay 可写分区）
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# ==================== LuCI 基础与中文语言包 ====================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh-cn=y

# ==================== 时区数据 ====================
CONFIG_PACKAGE_zoneinfo-asia=y

# ==================== 主题：默认 Argon（第 7、8 项） ====================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-argon-zh-cn=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ==================== 预装插件清单（含中文语言包） ====================

# --- 1. luci-app-smartdns DNS 广告过滤/分流 ---
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y
CONFIG_PACKAGE_smartdns=y

# --- 2. luci-app-ddnsto 内网穿透（kenzok8 版默认中文界面） ---
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y

# --- 3. luci-app-adguardhome 广告过滤（主程序 + 运行依赖） ---
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_adguardhome=y

# --- 4. luci-app-oaf 应用过滤 + kmod-oaf 内核模块（随源码内核编译，版本严格匹配） ---
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y

# --- 5. luci-app-turboacc：仅保留 流量分载 / 全锥形NAT / BBR，剔除其余组件 ---
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-i18n-turboacc-zh-cn=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y   # 软件流量分载（flow offloading）
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y           # BBR 拥塞控制算法
CONFIG_PACKAGE_kmod-nft-fullcone=y                  # 全锥形 NAT 内核模块（随内核源码编译）
CONFIG_PACKAGE_kmod-tcp-bbr=y                       # BBR 内核模块
CONFIG_PACKAGE_kmod-ipt-offload=y                   # 流量分载依赖
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FAST_CLASSIFIER is not set   # 已剔除：fast classifier
# CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE_CM is not set   # 已剔除：shortcut-fe 连接管理
# CONFIG_PACKAGE_TURBOACC_INCLUDE_NO_FASTPATH is not set      # 已剔除：NSS ECM（x86 无 NSS）

# --- 6. luci-app-mwan3 多拨负载均衡 ---
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_mwan3=y

# --- 7/8. luci-theme-argon + luci-theme-argon-config 见上方主题区 ---

# --- 9. luci-app-nlbwmon 带宽监控 ---
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# --- 10. luci-app-easytier 异地组网 ---
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
CONFIG_PACKAGE_easytier=y

# --- 11. luci-app-wol 网络唤醒 ---
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# --- 12. luci-app-upnp 端口转发 ---
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_miniupnpd=y

# --- 13. luci-app-ttyd 网页终端 ---
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_ttyd=y

# --- 14. luci-app-autoreboot 定时重启 ---
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# --- 15. luci-app-wechatpush 微信推送 ---
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y

# ==================== 有线网卡驱动 ====================
CONFIG_PACKAGE_kmod-igb=y               # Intel I211 / I210 / I350
CONFIG_PACKAGE_kmod-igc=y               # Intel I225 / I226
CONFIG_PACKAGE_kmod-e1000e=y            # Intel 千兆
CONFIG_PACKAGE_kmod-r8168=y             # Realtek RTL8111 系列（厂商驱动）
CONFIG_PACKAGE_kmod-r8169=y             # Realtek RTL8169（内核原生驱动）

# ==================== USB 网卡驱动 ====================
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# ==================== USB 存储与文件系统 ====================
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ==================== 常用工具与磁盘管理 ====================
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_usbids=y
CONFIG_PACKAGE_pciids=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_kmod-button-hotplug=y
CONFIG_PACKAGE_kmod-hwmon-core=y

# ==================== 有线网络辅助 ====================
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_autocore-x86=y
